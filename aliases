# Get external IP
alias myip="curl -s https://ipinfo.io/json"

# Serve the current directory over HTTP (Python, no Ruby needed)
alias serve='python3 -m http.server 8000'

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Git
alias g="git"
alias gl="git log --graph --oneline --decorate --all"
alias gs="git status"
alias gd="git diff"
